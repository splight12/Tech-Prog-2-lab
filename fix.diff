+def hash_password(password):
+    salt = secrets.token_bytes(16)  #у каждого пароля своя случайная соль
+    digest = hashlib.pbkdf2_hmac("sha256", password.encode("utf-8"), salt, ITERATIONS)
+    return salt.hex() + "$" + digest.hex()
+
+
+def check_password(password, saved): #пароль, верный пароль с хэшем
+    try:
+        salt, saved_digest = saved.split("$")
+        digest = hashlib.pbkdf2_hmac("sha256", password.encode("utf-8"), bytes.fromhex(salt), ITERATIONS)
+    except (ValueError, AttributeError):
+        return False
+    return hmac.compare_digest(digest.hex(), saved_digest) #сравниваем хеш введенного с правильным
 
 
